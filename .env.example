# Template for the staging server's env file at /opt/docker/taskflow/.env.
# docker-compose.yml passes it to taskflow_api. Keep the real file on the server
# only, readable by the runner user (chmod 600). Never commit it.

# Signs login tokens. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it logs everyone out. The API refuses to start with a known default
# or a key shorter than 32 characters.
SECRET_KEY=

# Four slashes: an absolute path inside the container. /data is the
# taskflow_taskflow_data volume, so the DB survives deploys.
DATABASE_URL=sqlite:////data/taskflow.db

# How long a browser login lasts, in minutes (480 = 8 hours).
ACCESS_TOKEN_EXPIRE_MINUTES=480

# JSON list. The browser calls the API on the same origin, so CORS never
# applies in practice; this only replaces the localhost default.
CORS_ORIGINS=["https://tasks.qader.vip"]

# Longest lifetime of a personal API token, in days.
API_TOKEN_MAX_DAYS=90

# Comma-separated task ID prefixes the hub must refuse in text (for example
# the prefixes of a private tracker). Keep the real list on the server only.
LINT_BLOCKED_ID_PREFIXES=

# Comma-separated path fragments the hub must refuse in text (private
# folders). Keep the real list on the server only.
LINT_BLOCKED_PATHS=

# Attachments: size of one file and of all files together, in MB.
FILE_MAX_MB=10
FILES_TOTAL_MB=200

# Hosts a task's context link may point at (subdomains included).
CONTEXT_URL_HOSTS=github.com,qader.com,qader.vip
