# Template for the staging server's env file at /opt/docker/taskflow/.env.
# docker-compose.yml passes it to taskflow_api. Keep the real file on the server
# only, readable by the runner user (chmod 600). Never commit it.
#
# Every setting the API reads is listed here. Lines you leave out fall back to
# the default shown. Two are set by docker-compose.yml, not here:
#   APP_ENV=production   turns on the start-up checks (weak SECRET_KEY refused)
#   FILES_DIR=/data/files   where attachments are stored, inside the data volume

# --- core -------------------------------------------------------------------

# Signs login tokens. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it logs everyone out. The API refuses to start with a known default
# or a key shorter than 32 characters.
SECRET_KEY=

# JWT signing algorithm. Leave as is.
ALGORITHM=HS256

# Four slashes: an absolute path inside the container. /data is the
# taskflow_taskflow_data volume, so the DB survives deploys.
DATABASE_URL=sqlite:////data/taskflow.db

# How long a browser login lasts, in minutes (480 = 8 hours).
ACCESS_TOKEN_EXPIRE_MINUTES=480

# JSON list. The browser calls the API on the same origin, so CORS never
# applies in practice; this only replaces the localhost default.
CORS_ORIGINS=["https://tasks.qader.vip"]

# --- agents: tokens, limits, claims -----------------------------------------

# Longest lifetime of a personal API token, in days.
API_TOKEN_MAX_DAYS=90

# Requests per minute: login attempts per address and email, and per token.
RATE_LOGIN_PER_MINUTE=5
RATE_TOKEN_READS_PER_MINUTE=300
RATE_TOKEN_WRITES_PER_MINUTE=60

# Claim lease in hours: the default, and the most anyone may ask for.
CLAIM_DEFAULT_HOURS=2
CLAIM_MAX_HOURS=8

# --- text checks --------------------------------------------------------------

# Comma-separated task ID prefixes the hub must refuse in text (for example
# the prefixes of a private tracker). Keep the real list on the server only.
LINT_BLOCKED_ID_PREFIXES=

# Comma-separated path fragments the hub must refuse in text (private
# folders). Keep the real list on the server only.
LINT_BLOCKED_PATHS=

# --- documents, files, context links ------------------------------------------

# Attachments: size of one file and of all files together, in MB. If you raise
# FILE_MAX_MB, raise client_max_body_size in frontend/nginx.conf and in the
# Qader nginx that serves tasks.qader.vip too (11m covers 10 MB).
FILE_MAX_MB=10
FILES_TOTAL_MB=200

# Hosts a task's context link may point at (subdomains included).
CONTEXT_URL_HOSTS=github.com,qader.com,qader.vip

# --- email notifications (off until SMTP_HOST and SMTP_FROM are set) ---------

# Gmail: create an app password on the sending account (Google Account >
# Security > 2-Step Verification > App passwords) and put it in SMTP_PASSWORD,
# never in the repo. One normal Gmail account sends to about 500 recipients a day.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Qader team hub
SMTP_TIMEOUT_SECONDS=20

# Links in emails point here.
HUB_BASE_URL=https://tasks.qader.vip

# One email per person collects everything from this many seconds; the sender
# wakes every EMAIL_POLL_SECONDS.
EMAIL_BATCH_SECONDS=120
EMAIL_POLL_SECONDS=30
EMAIL_MAX_PER_USER_HOUR=20
EMAIL_MAX_PER_DAY=400
EMAIL_MAX_ATTEMPTS=5

# "auto" runs the sender when SMTP is set; "off" never sends.
EMAIL_SENDER=auto
